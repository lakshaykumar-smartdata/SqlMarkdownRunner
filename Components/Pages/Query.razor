@page "/"
@implements IDisposable
@inject Session Session
@inject HistoryStore History
@inject ObjectCache Cache
@inject SavedRuns Runs
@inject IJSRuntime JS
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>SQL to markdown</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">Run SQL</MudText>

@if (Session.Current is null)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mb-4">
        No connections yet — <MudLink Href="settings">add one first</MudLink>.
    </MudAlert>
}

<MudGrid Spacing="3">
    <MudItem xs="12" lg="8">
        <MudPaper Elevation="0" Outlined="true" Class="pa-4">
            <MudTextField @bind-Value="_sql" T="string" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Lines="18" Class="mono sql-editor" Label="SQL"
                          HelperText="GO batch separators supported. Drag a name from the panel to insert it."
                          Placeholder="SELECT TOP 10 * FROM sys.tables;" />

            <MudStack Row="true" Spacing="2" Class="mt-4" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RunAsync"
                           Disabled="@(_running || Session.Current is null)"
                           StartIcon="@Icons.Material.Filled.PlayArrow">
                    @(_running ? "Running…" : "Run")
                </MudButton>
                @if (_markdown is not null)
                {
                    <MudButton Variant="Variant.Outlined" OnClick="Copy"
                               StartIcon="@Icons.Material.Outlined.ContentCopy">Copy markdown</MudButton>
                    <MudButton Variant="Variant.Outlined" OnClick="Download"
                               StartIcon="@Icons.Material.Outlined.Download">Download .md</MudButton>
                }
                <MudButton Variant="Variant.Text" OnClick="Clear">Clear</MudButton>
                <MudSpacer />
                @if (Session.Current is { } c)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        timeout @c.TimeoutSeconds s · auto-save @(c.AutoSaveMarkdown ? "on" : "off")
                    </MudText>
                }
            </MudStack>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" lg="4">
        <MudPaper Elevation="0" Outlined="true" Class="pa-4 objects">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                <MudText Typo="Typo.subtitle2">Database objects</MudText>
                <MudSpacer />
                @if (_fetchedAt is not null)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@_fetchedAt.Value.ToString("MMM d, HH:mm")</MudText>
                }
                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="LoadObjectsAsync"
                           Disabled="@(_loadingObjects || Session.Current is null)">
                    @(_loadingObjects ? "Loading…" : _objects.Count == 0 ? "Load" : "Refresh")
                </MudButton>
            </MudStack>

            @if (_objectError is not null)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true">@_objectError</MudAlert>
            }
            else if (_objects.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    Load this database's tables, views, procedures and functions, then drag a name into the editor.
                </MudText>
            }
            else
            {
                <MudTextField @bind-Value="_objectFilter" T="string" Immediate="true" Clearable="true"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search"
                              Placeholder="@($"Filter {_objects.Count} objects")" />

                <div class="objects-scroll">
                    @foreach (var group in Filtered.GroupBy(o => o.Kind))
                    {
                        <div class="objects-group">
                            <div class="objects-kind">@group.Key <span class="muted">@group.Count()</span></div>
                            @foreach (var o in group)
                            {
                                @if (o.Columns.Count > 0)
                                {
                                    <details>
                                        <summary class="objects-item" draggable="true" data-drag="@o.DragText" title="@o.DragText">@o.Name</summary>
                                        <div class="objects-cols">
                                            <div class="objects-actions">
                                                <button class="copy-schema" @onclick="() => CopySchemaAsync(o)">
                                                    @(_copiedKey == $"{o.Name}:schema" ? "Copied" : "Schema")
                                                </button>
                                                <button class="copy-schema" @onclick="() => CopySelectAsync(o)">
                                                    @(_copiedKey == $"{o.Name}:select" ? "Copied" : "SELECT")
                                                </button>
                                            </div>
                                            @foreach (var col in o.Columns)
                                            {
                                                <div class="objects-col" draggable="true" data-drag="@col.Name">
                                                    <span>@col.Name</span><span class="muted">@col.Type</span>
                                                </div>
                                            }
                                        </div>
                                    </details>
                                }
                                else
                                {
                                    <div class="objects-item" draggable="true" data-drag="@o.DragText" title="@o.DragText">@o.Name</div>
                                }
                            }
                        </div>
                    }

                    @if (!Filtered.Any())
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">Nothing matches that filter.</MudText>
                    }
                </div>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@if (_markdown is not null)
{
    <MudText Typo="Typo.h6" Class="mt-8 mb-3">Result</MudText>
    <MudPaper Elevation="0" Outlined="true" Class="pa-6">
        <div class="rendered">@_rendered</div>
    </MudPaper>
}

@code {
    private string _sql = "";
    private bool _running;
    private string? _markdown;
    private MarkupString _rendered;

    private List<DbObject> _objects = [];
    private string _objectFilter = "";
    private string? _objectError, _copiedKey;
    private DateTime? _fetchedAt;
    private bool _loadingObjects;

    private IEnumerable<DbObject> Filtered => string.IsNullOrEmpty(_objectFilter)
        ? _objects
        : _objects.Where(o => o.Name.Contains(_objectFilter, StringComparison.OrdinalIgnoreCase));

    /// <summary>Set by the history page Open button to reload a past query.</summary>
    [SupplyParameterFromQuery(Name = "from")] public string? From { get; set; }

    protected override void OnInitialized()
    {
        Session.Changed += OnConnectionChanged;

        var past = From is null ? null : History.Find(From);
        if (past is not null)
        {
            _sql = past.Sql;
            Session.Name = past.Connection;
        }

        LoadFromCache();
    }

    public void Dispose() => Session.Changed -= OnConnectionChanged;

    private void OnConnectionChanged()
    {
        LoadFromCache();
        InvokeAsync(StateHasChanged);
    }

    /// <summary>Schema listings persist, so switching connections shows what was fetched before.</summary>
    private void LoadFromCache()
    {
        var cached = Session.Name is null ? null : Cache.Get(Session.Name);
        (_objects, _fetchedAt, _objectFilter, _objectError) = (cached?.Objects ?? [], cached?.FetchedAt, "", null);
    }

    private async Task LoadObjectsAsync()
    {
        if (Session.Current is not { } entry) return;

        (_loadingObjects, _objectError) = (true, null);
        try
        {
            _objects = await SqlRunner.ListObjectsAsync(entry);
            _fetchedAt = DateTime.Now;
            Cache.Set(entry.Name, _objects);
        }
        catch (Exception ex)
        {
            (_objects, _fetchedAt, _objectError) = ([], null, ex.Message);
        }
        finally
        {
            _loadingObjects = false;
        }
    }

    private async Task RunAsync()
    {
        if (Session.Current is not { } entry || string.IsNullOrWhiteSpace(_sql)) return;
        if (!await ConfirmUnfilteredWritesAsync()) return;

        _running = true;
        try
        {
            _markdown = await SqlRunner.RunAsMarkdownAsync(entry, _sql, entry.TimeoutSeconds);
            _rendered = MarkdownView.Render(_markdown);
        }
        finally
        {
            _running = false;
        }

        History.Add(entry.Name, _sql);
        if (entry.AutoSaveMarkdown && _markdown is not null) Runs.Save(entry.Name, _markdown);
    }

    /// <summary>An UPDATE or DELETE with no WHERE hits every row, so make the user say yes first.</summary>
    private async Task<bool> ConfirmUnfilteredWritesAsync()
    {
        var risky = SqlRunner.StatementsMissingWhere(_sql);
        if (risky.Count == 0) return true;

        var what = risky.Count == 1 ? "This statement has" : $"These {risky.Count} statements have";
        var message = $"{what} no WHERE clause, so every row in the target table will be affected:";
        var listed = string.Join("<br>", risky.Select(r => $"<code>{r}</code>"));

        var ok = await Dialogs.ShowMessageBoxAsync(
            "Run without a WHERE clause?",
            (MarkupString)$"{message}<br><br>{listed}",
            yesText: "Run anyway", cancelText: "Cancel");

        return ok == true;
    }

    private void Clear() => (_sql, _markdown, _rendered) = ("", null, default);

    /// <summary>Column names and types as a markdown table, ready to paste into an LLM.</summary>
    private async Task CopySchemaAsync(DbObject o)
    {
        var rows = o.Columns.Select(c =>
            $"| {c.Name} | {c.Type} | {(c.Nullable ? "NULL" : "NOT NULL")} | {(c.IsPrimaryKey ? "PK" : "")} |");

        var schema = $"### {o.Name}\n\n| column | type | null | key |\n| --- | --- | --- | --- |\n"
                     + string.Join("\n", rows);

        await JS.InvokeVoidAsync("smr.copy", schema);
        _copiedKey = $"{o.Name}:schema";
    }

    /// <summary>A SELECT that names every column, capped like SSMS so a wide table cannot flood.</summary>
    private async Task CopySelectAsync(DbObject o)
    {
        var columns = string.Join(",\n", o.Columns.Select(c => $"    {c.Name}"));
        await JS.InvokeVoidAsync("smr.copy", $"SELECT TOP 100\n{columns}\nFROM {o.Name};");
        _copiedKey = $"{o.Name}:select";
    }

    private async Task Copy()
    {
        await JS.InvokeVoidAsync("smr.copy", _markdown);
        Snackbar.Add("Markdown copied", Severity.Success);
    }

    private Task Download() =>
        JS.InvokeVoidAsync("smr.download", $"sql-run-{DateTime.Now:yyyyMMdd-HHmmss}.md", _markdown).AsTask();
}
