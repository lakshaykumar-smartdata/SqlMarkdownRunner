@page "/history"
@implements IDisposable
@inject Session Session
@inject HistoryStore Hist
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>Query history</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <div>
        <MudText Typo="Typo.h5">Query history</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            Last @HistoryStore.MaxEntries runs per connection, stored in <code>@Hist.FilePath</code>
        </MudText>
    </div>
    <MudSpacer />
    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
               StartIcon="@Icons.Material.Outlined.DeleteSweep"
               Disabled="@(_entries.Count == 0)" OnClick="ClearAsync">
        Clear history
    </MudButton>
</MudStack>

@if (_entries.Count == 0)
{
    <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined" Dense="true">
        Nothing here yet for this connection. Run a query and it will show up.
    </MudAlert>
}
else
{
    <MudTable Items="_entries" Dense="true" Hover="true" Elevation="0" Outlined="true" Breakpoint="Breakpoint.None">
        <HeaderContent>
            <MudTh Style="width:11rem">Run at</MudTh>
            <MudTh>SQL</MudTh>
            <MudTh Style="width:1%" />
        </HeaderContent>
        <RowTemplate>
            <MudTd Class="nowrap">@context.RunAt.ToString("yyyy-MM-dd HH:mm:ss")</MudTd>
            <MudTd><pre class="sql">@context.Sql</pre></MudTd>
            <MudTd Class="nowrap">
                <MudTooltip Text="Load into the editor">
                    <MudIconButton Icon="@Icons.Material.Outlined.OpenInNew" Size="Size.Small"
                                   Color="Color.Primary" OnClick="@(() => Open(context))" />
                </MudTooltip>
                <MudTooltip Text="Copy SQL">
                    <MudIconButton Icon="@Icons.Material.Outlined.ContentCopy" Size="Size.Small"
                                   OnClick="@(() => CopyAsync(context))" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private List<HistoryEntry> _entries = [];

    protected override void OnInitialized()
    {
        Session.Changed += OnConnectionChanged;
        Reload();
    }

    public void Dispose() => Session.Changed -= OnConnectionChanged;

    private void OnConnectionChanged()
    {
        Reload();
        InvokeAsync(StateHasChanged);
    }

    private void Reload() =>
        _entries = Session.Name is null ? [] : Hist.Load().Where(e => e.Connection == Session.Name).ToList();

    private void Open(HistoryEntry e) => Nav.NavigateTo($"/?from={e.Id}");

    private async Task CopyAsync(HistoryEntry e)
    {
        await JS.InvokeVoidAsync("smr.copy", e.Sql);
        Snackbar.Add("SQL copied", Severity.Success);
    }

    private async Task ClearAsync()
    {
        var ok = await Dialogs.ShowMessageBoxAsync(
            "Clear history?",
            $"Deletes {_entries.Count} entr{(_entries.Count == 1 ? "y" : "ies")} for {Session.Name}.",
            yesText: "Clear", cancelText: "Cancel");

        if (ok != true) return;

        Hist.Clear(Session.Name);
        Reload();
        Snackbar.Add("History cleared", Severity.Success);
    }
}
