@page "/history"
@implements IDisposable
@inject Session Session
@inject HistoryStore Hist
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Query history</PageTitle>

<h1>Query history</h1>
<p class="muted">Last @HistoryStore.MaxEntries runs, stored in <code>@Hist.FilePath</code>.</p>

<div class="form">
    <div class="row">
        <button @onclick="ClearAsync" disabled="@(_entries.Count == 0)">Clear history for this connection</button>
        <span class="muted">@_copied</span>
    </div>
</div>

@if (_entries.Count == 0)
{
    <p class="muted" style="margin-top:1.25rem">Nothing here yet — run a query and it will show up.</p>
}
else
{
    <table class="grid history">
        <thead>
            <tr><th style="width:11rem">Run at</th><th>SQL</th><th style="width:1%"></th></tr>
        </thead>
        <tbody>
            @foreach (var e in _entries)
            {
                <tr>
                    <td class="nowrap">@e.RunAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <td><pre class="sql">@e.Sql</pre></td>
                    <td class="nowrap">
                        <button @onclick="() => Open(e)">Open</button>
                        <button @onclick="() => CopyAsync(e)">Copy</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<HistoryEntry> _entries = [];
    private string? _copied;

    protected override void OnInitialized()
    {
        Session.Changed += OnConnectionChanged;
        Reload();
    }

    public void Dispose() => Session.Changed -= OnConnectionChanged;

    private void OnConnectionChanged()
    {
        Reload();
        InvokeAsync(StateHasChanged);
    }

    private void Reload()
    {
        _copied = null;
        _entries = Session.Name is null ? [] : Hist.Load().Where(e => e.Connection == Session.Name).ToList();
    }

    private void Open(HistoryEntry e) => Nav.NavigateTo($"/?from={e.Id}");

    private async Task CopyAsync(HistoryEntry e)
    {
        await JS.InvokeVoidAsync("smr.copy", e.Sql);
        _copied = "SQL copied.";
    }

    private async Task ClearAsync()
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Delete {_entries.Count} history entr{(_entries.Count == 1 ? "y" : "ies")}?")) return;
        Hist.Clear(Session.Name);
        Reload();
    }
}
