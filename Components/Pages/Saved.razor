@page "/saved"
@implements IDisposable
@inject Session Session
@inject SavedRuns Runs
@inject IJSRuntime JS
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>Saved runs</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
    <div>
        <MudText Typo="Typo.h5">Saved runs</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            @_matches.Count of @_files.Count file(s) under <code>@Runs.Root</code>
        </MudText>
    </div>
    <MudSpacer />
    <MudTextField @bind-Value="_filter" @bind-Value:after="ApplyFilter" T="string"
                  Immediate="true" DebounceInterval="300" Clearable="true"
                  Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:20rem"
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search"
                  Placeholder="Search inside the saved markdown" />
</MudStack>

@if (_matches.Count == 0)
{
    <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined" Dense="true">
        @(_filter == "" ? "Nothing saved yet for this connection. Turn on auto-save for it under Connections."
                        : "No saved run contains that text.")
    </MudAlert>
}
else
{
    <MudGrid Spacing="3">
        <MudItem xs="12" md="5">
            <MudPaper Elevation="0" Outlined="true" Class="saved-list">
                @foreach (var f in _matches)
                {
                    <div class="saved-item @(f.FileName == _openFile ? "selected" : "")" @onclick="() => Open(f)">
                        <div class="saved-item-text">
                            <div class="saved-name">@f.FileName</div>
                            <div class="saved-meta">
                                @f.SavedAt.ToString("yyyy-MM-dd HH:mm:ss") · @($"{f.Bytes / 1024.0:N1} KB")
                            </div>
                        </div>
                        <MudTooltip Text="Delete">
                            <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error"
                                           OnClick="@(() => DeleteAsync(f))" />
                        </MudTooltip>
                    </div>
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="7">
            <div class="saved-preview">
                @if (_markdown is null)
                {
                    <MudPaper Elevation="0" Outlined="true" Class="pa-8 d-flex justify-center align-center saved-empty">
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">Pick a run on the left to preview it.</MudText>
                    </MudPaper>
                }
                else
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                        <MudText Typo="Typo.subtitle2" Class="saved-open-name">@_openFile</MudText>
                        <MudSpacer />
                        <MudTooltip Text="Copy markdown">
                            <MudIconButton Icon="@Icons.Material.Outlined.ContentCopy" Size="Size.Small"
                                           Color="Color.Primary" OnClick="CopyAsync" />
                        </MudTooltip>
                        <MudTooltip Text="Download .md">
                            <MudIconButton Icon="@Icons.Material.Outlined.Download" Size="Size.Small"
                                           Color="Color.Primary" OnClick="DownloadAsync" />
                        </MudTooltip>
                    </MudStack>

                    <MudPaper Elevation="0" Outlined="true" Class="pa-5 saved-markdown">
                        <div class="rendered">@MarkdownView.Render(_markdown)</div>
                    </MudPaper>
                }
            </div>
        </MudItem>
    </MudGrid>
}

@code {
    private List<SavedRun> _files = [], _matches = [];
    private string _filter = "";
    private string? _openFile, _markdown;

    protected override void OnInitialized()
    {
        Session.Changed += OnConnectionChanged;
        Reload();
    }

    public void Dispose() => Session.Changed -= OnConnectionChanged;

    private void OnConnectionChanged()
    {
        Reload();
        InvokeAsync(StateHasChanged);
    }

    private void Reload()
    {
        _files = Session.Name is null ? [] : Runs.List(Session.Name);
        (_openFile, _markdown) = (null, null);
        ApplyFilter();
    }

    /// <summary>
    /// File names are only timestamps, so the search reads the markdown itself. Debounced,
    /// since that means opening every file for the connection.
    /// </summary>
    private void ApplyFilter()
    {
        if (string.IsNullOrWhiteSpace(_filter))
        {
            _matches = _files;
            return;
        }

        _matches = _files
            .Where(f => (Runs.Read(Session.Name!, f.FileName) ?? "")
                .Contains(_filter, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private void Open(SavedRun f)
    {
        _openFile = f.FileName;
        _markdown = Runs.Read(Session.Name!, f.FileName) ?? "_File is gone from disk._";
    }

    private async Task DeleteAsync(SavedRun f)
    {
        var ok = await Dialogs.ShowMessageBoxAsync(
            "Delete saved run?", f.FileName, yesText: "Delete", cancelText: "Cancel");

        if (ok != true) return;

        Runs.Delete(Session.Name!, f.FileName);
        Reload();   // also closes the preview if that was the open file
        Snackbar.Add($"Deleted {f.FileName}", Severity.Success);
    }

    private async Task CopyAsync()
    {
        await JS.InvokeVoidAsync("smr.copy", _markdown);
        Snackbar.Add("Markdown copied", Severity.Success);
    }

    private Task DownloadAsync() =>
        JS.InvokeVoidAsync("smr.download", _openFile, _markdown).AsTask();
}
