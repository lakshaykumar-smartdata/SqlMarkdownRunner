@page "/saved"
@implements IDisposable
@inject Session Session
@inject SavedRuns Runs
@inject IJSRuntime JS

<PageTitle>Saved runs</PageTitle>

<h1>Saved runs</h1>
<p class="muted">Auto-saved markdown, stored under <code>@Runs.Root</code>.</p>

@if (_status is not null)
{
    <p class="ok">@_status</p>
}

@if (_files.Count == 0)
{
    <p class="muted">Nothing saved yet for this connection — run a query with auto-save ticked.</p>
}
else
{
    <table class="grid">
        <thead>
            <tr><th>File</th><th style="width:11rem">Saved at</th><th style="width:6rem">Size</th><th style="width:1%"></th></tr>
        </thead>
        <tbody>
            @foreach (var f in _files)
            {
                <tr class="@(f.FileName == _openFile ? "open" : null)">
                    <td><code>@f.FileName</code></td>
                    <td class="nowrap">@f.SavedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <td class="nowrap">@($"{f.Bytes / 1024.0:N1} KB")</td>
                    <td class="nowrap">
                        <button @onclick="() => Open(f)">Open</button>
                        <button @onclick="() => DeleteAsync(f)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (_markdown is not null)
{
    <h2>@_openFile</h2>
    <div class="row" style="margin-bottom:.75rem">
        <button @onclick="CopyAsync">Copy markdown</button>
        <button @onclick="DownloadAsync">Download .md</button>
        <span class="muted">@_status</span>
    </div>
    <div class="rendered">@MarkdownView.Render(_markdown)</div>
}

@code {
    private List<SavedRun> _files = [];
    private string? _openFile, _markdown, _status;

    protected override void OnInitialized()
    {
        Session.Changed += OnConnectionChanged;
        Reload();
    }

    private void Reload()
    {
        _files = Session.Name is null ? [] : Runs.List(Session.Name);
        (_openFile, _markdown, _status) = (null, null, null);
    }

    public void Dispose() => Session.Changed -= OnConnectionChanged;

    private void OnConnectionChanged()
    {
        Reload();
        InvokeAsync(StateHasChanged);
    }

    private void Open(SavedRun f)
    {
        (_openFile, _status) = (f.FileName, null);
        _markdown = Runs.Read(Session.Name!, f.FileName) ?? "_File is gone from disk._";
    }

    private async Task DeleteAsync(SavedRun f)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Delete {f.FileName}?")) return;

        Runs.Delete(Session.Name!, f.FileName);
        Reload();   // also closes the preview if that was the open file
        _status = $"Deleted {f.FileName}.";
    }

    private async Task CopyAsync()
    {
        await JS.InvokeVoidAsync("smr.copy", _markdown);
        _status = "Copied.";
    }

    private Task DownloadAsync() =>
        JS.InvokeVoidAsync("smr.download", _openFile, _markdown).AsTask();
}
