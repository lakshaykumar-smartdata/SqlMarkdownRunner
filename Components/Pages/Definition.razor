@page "/definition"
@inject ConnectionStore Store
@inject SavedRuns Runs
@inject IJSRuntime JS
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>@(Name ?? "Definition")</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
    <div>
        <MudText Typo="Typo.h5">@Name</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">@Connection</MudText>
    </div>
    <MudSpacer />

    @if (_editing)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_saving"
                   StartIcon="@Icons.Material.Outlined.Save">
            @(_saving ? "Saving…" : "Save to database")
        </MudButton>
        <MudButton Variant="Variant.Text" OnClick="CancelEdit" Disabled="_saving">Cancel</MudButton>
    }
    else
    {
        @if (_entry?.IsProduction == true)
        {
            <MudTooltip Text="This connection is marked production">
                <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined"
                         Icon="@Icons.Material.Outlined.Lock">read-only</MudChip>
            </MudTooltip>
        }
        else
        {
            <MudButton Variant="Variant.Outlined" OnClick="StartEdit" Disabled="@(_definition is null)"
                       StartIcon="@Icons.Material.Outlined.Edit">Edit</MudButton>
        }
        <MudButton Variant="Variant.Outlined" OnClick="ToggleRunner" Disabled="@(_routine is null)"
                   StartIcon="@Icons.Material.Filled.PlayArrow">
            @(_showRunner ? "Hide run" : "Execute")
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CopyAsync"
                   Disabled="@(_definition is null)"
                   StartIcon="@Icons.Material.Outlined.ContentCopy">Copy definition</MudButton>
    }
</MudStack>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-4">@_error</MudAlert>
}

@if (_showRunner && _routine is not null)
{
    <MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-4">
        <MudText Typo="Typo.subtitle2" Class="mb-3">Run this @(_routine.IsFunction ? "function" : "procedure")</MudText>

        @if (_routine.Parameters.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">It takes no parameters.</MudText>
        }
        else
        {
            <MudGrid Spacing="3" Class="mb-2">
                @foreach (var p in _routine.Parameters)
                {
                    <MudItem xs="12" sm="6" md="4">
                        <MudTextField @bind-Value="_arguments[p.Name]" T="string"
                                      Label="@p.Name" HelperText="@(p.IsOutput ? p.Type + ", OUTPUT" : p.Type)"
                                      Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Placeholder="NULL" Class="mono" />
                    </MudItem>
                }
            </MudGrid>
        }

        <pre class="call-preview">@SqlRunner.CallSyntax(_routine, Name!)</pre>

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-3">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RunAsync" Disabled="_running"
                       StartIcon="@Icons.Material.Filled.PlayArrow">
                @(_running ? "Running…" : "Run")
            </MudButton>
            @if (_result is not null)
            {
                <MudButton Variant="Variant.Outlined" OnClick="CopyResultAsync"
                           StartIcon="@Icons.Material.Outlined.ContentCopy">Copy markdown</MudButton>
            }
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                empty box = NULL · timeout @_entry!.TimeoutSeconds s
            </MudText>
        </MudStack>

        @if (_result is not null)
        {
            <MudDivider Class="my-4" />
            <div class="rendered">@MarkdownView.Render(_result)</div>
        }
    </MudPaper>
}

@if (_editing)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mb-3">
        Saving runs ALTER against <strong>@Connection</strong> straight away. The current definition is
        backed up to Saved runs first.
    </MudAlert>

    <MudTextField @bind-Value="_draft" T="string" Variant="Variant.Outlined" Margin="Margin.Dense"
                  Lines="30" Class="mono" Label="Definition" />
}
else if (_definition is null && _error is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_definition is not null)
{
    <MudPaper Elevation="0" Outlined="true" Class="pa-4">
        <pre class="definition-full">@_definition</pre>
    </MudPaper>
}

@code {
    [SupplyParameterFromQuery] public string? Connection { get; set; }
    [SupplyParameterFromQuery] public string? Name { get; set; }

    private DbConnectionEntry? _entry;
    private string? _definition, _error;
    private string _draft = "";
    private bool _editing, _saving, _showRunner, _running;
    private SqlRunner.RoutineInfo? _routine;
    private readonly Dictionary<string, string> _arguments = [];
    private string? _result;

    protected override async Task OnInitializedAsync()
    {
        _entry = Store.Load().FirstOrDefault(c => c.Name == Connection);
        if (_entry is null || string.IsNullOrWhiteSpace(Name))
        {
            _error = "Unknown connection or object.";
            return;
        }

        await LoadAsync();
        _routine = await SqlRunner.GetRoutineAsync(_entry, Name!);

        foreach (var p in _routine?.Parameters ?? [])
            _arguments[p.Name] = "";
    }

    private async Task LoadAsync()
    {
        try
        {
            _definition = await SqlRunner.GetDefinitionAsync(_entry!, Name!)
                          ?? "-- No definition available (the object may be encrypted).";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void StartEdit() => (_editing, _draft, _error) = (true, _definition ?? "", null);

    private void CancelEdit() => (_editing, _draft) = (false, "");

    private async Task SaveAsync()
    {
        if (_entry is null || string.IsNullOrWhiteSpace(_draft)) return;
        if (_entry.IsProduction) { _error = $"{_entry.Name} is marked production and is read-only."; return; }

        var ok = await Dialogs.ShowMessageBoxAsync(
            "Save to the database?",
            (MarkupString)($"<code>{Name}</code> will be altered on <strong>{_entry.Name}</strong> " +
                           "immediately, and this cannot be undone.<br><br>" +
                           "The definition as it stands now is backed up to Saved runs first."),
            yesText: "Save", cancelText: "Cancel");

        if (ok != true) return;

        _saving = true;
        try
        {
            Backup();
            await SqlRunner.AlterAsync(_entry, _draft);

            _editing = false;
            await LoadAsync();   // show what is actually stored now
            Snackbar.Add($"{Name} saved to {_entry.Name}", Severity.Success);
        }
        catch (Exception ex)
        {
            _error = ex.Message;   // the draft stays open so the edit is not lost
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>Keeps the pre-change text, so a bad edit is always one copy-paste from recovery.</summary>
    private void Backup()
    {
        var markdown = $"# Definition backup — {Name}\n\n"
                       + $"- **Connection:** {_entry!.Name} — `{SqlRunner.Describe(_entry.ConnectionString)}`\n"
                       + $"- **Taken (local):** {DateTime.Now:yyyy-MM-dd HH:mm:ss}\n"
                       + "- **Reason:** definition about to be altered from this app\n\n"
                       + "```sql\n" + _definition + "\n```\n";

        Runs.Save(_entry.Name, markdown, Name);
    }

    private void ToggleRunner() => _showRunner = !_showRunner;

    private async Task RunAsync()
    {
        if (_entry is null || _routine is null) return;

        _running = true;
        try
        {
            var args = _routine.Parameters
                .Select(p => (p.Name, (string?)_arguments.GetValueOrDefault(p.Name)))
                .ToList();

            _result = await SqlRunner.RunAsMarkdownAsync(
                _entry, SqlRunner.CallSyntax(_routine, Name!), _entry.TimeoutSeconds, args);
        }
        finally
        {
            _running = false;
        }
    }

    private async Task CopyResultAsync()
    {
        await JS.InvokeVoidAsync("smr.copy", _result);
        Snackbar.Add("Markdown copied", Severity.Success);
    }

    private async Task CopyAsync()
    {
        await JS.InvokeVoidAsync("smr.copy", _definition);
        Snackbar.Add("Definition copied", Severity.Success);
    }
}
